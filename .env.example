# Copy to .env.local and fill in. Local env files are git-ignored; never commit real values.
# See .scratch/journeys-platform/human-prerequisites.md for where each value comes from.

# Postgres. Local: docker-compose Postgres on host port 5436 (5432-5434 are taken by other Postgres instances on Paul's machine and 5435 by an h2 console's Postgres server). Vercel: Neon pooled connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/journeys

# better-auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (redirect: <BETTER_AUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth (redirect: <BETTER_AUTH_URL>/api/auth/callback/discord)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Vercel AI Gateway key used by the Judge (deciding Prompts). Leave empty and a
# deciding Prompt lets the Participant choose instead of the Judge.
AI_GATEWAY_API_KEY=
