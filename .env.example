# Copy to .env.local and fill in. Local env files are git-ignored; never commit real values.
# See .scratch/journeys-platform/human-prerequisites.md for where each value comes from.

# Postgres. Local: docker-compose Postgres. Vercel: Neon pooled connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/journeys

# better-auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (redirect: <BETTER_AUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth (redirect: <BETTER_AUTH_URL>/api/auth/callback/discord)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Anthropic API key for AI authoring (priority 11). Leave empty to hide AI features.
ANTHROPIC_API_KEY=
