# atlas-v3:gitignore:start
.claude/worktrees/
.claude/atlas-state/
# Test evidence stays committable even where a team rule would ignore it.
# Both lines are needed: the first re-includes the directory (git will not
# descend into an ignored one), the second re-includes what is inside it.
# Neither can help if an ANCESTOR directory is ignored; git cannot
# re-include anything under an excluded parent.
!test-results/
!test-results/**
# atlas-v3:gitignore:end

# Environment files: only the template is tracked.
.env
.env.*
!.env.example

# dependencies
node_modules

# next.js
.next
out
build

# testing
coverage

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# misc
.DS_Store

# playwright. Note the narrow test-results path: only Playwright's scratch
# output is ignored, because committed evidence lives under test-results/.
/playwright-report/
/test-results/playwright/
